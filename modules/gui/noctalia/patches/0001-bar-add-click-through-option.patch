From: Linus Ammon <235536459+linusammon@users.noreply.github.com>
Date: Wed, 8 Jul 2026 23:26:20 +0200
Subject: [PATCH] bar: add click_through option for dead-zone pointer
 passthrough

Signed-off-by: Linus Ammon <235536459+linusammon@users.noreply.github.com>
---
 assets/translations/en.json              |  4 ++
 src/config/config_types.h                |  1 +
 src/config/schema/config_schema.cpp      |  1 +
 src/shell/bar/bar.cpp                    | 45 ++++++++++++++++++++++--
 src/shell/settings/settings_registry.cpp | 10 +++++
diff --git a/assets/translations/en.json b/assets/translations/en.json
index b9de2db..60fb832 100644
--- a/assets/translations/en.json
+++ b/assets/translations/en.json
@@ -2006,6 +2006,10 @@
           "description": "Carve concave notches into two of the bar's corners (requires Edge Margin to be 0); with Ends Margin at 0, the corners on the bar's inner edge are carved, otherwise the corners touching the screen edge are carved",
           "label": "Concave Edge Corners"
         },
+        "click-through": {
+          "description": "Let pointer events pass through empty bar areas to windows below",
+          "label": "Click-Through"
+        },
         "contact-shadow": {
           "description": "Dark gradient between an attached panel and the bar to suggest depth at the seam"
         },
diff --git a/src/config/config_types.h b/src/config/config_types.h
index e16fb17..f40f1bf 100644
--- a/src/config/config_types.h
+++ b/src/config/config_types.h
@@ -207,6 +207,7 @@ struct BarConfig {
   // Default for the per-widget `show_tooltip`; widgets on this bar show hover tooltips unless overridden.
   bool showTooltip = true;
   BarDeadZoneConfig deadZone;
+  bool clickThrough = false;
   std::vector<BarMonitorOverride> monitorOverrides;
 
   bool operator==(const BarConfig&) const = default;
diff --git a/src/config/schema/config_schema.cpp b/src/config/schema/config_schema.cpp
index 8619822..56ea01b 100644
--- a/src/config/schema/config_schema.cpp
+++ b/src/config/schema/config_schema.cpp
@@ -2417,6 +2417,7 @@ namespace noctalia::config::schema {
         field(&BarConfig::hoverHighlight, "hover_highlight"),
         field(&BarConfig::showTooltip, "show_tooltip"),
         subTable(&BarConfig::deadZone, "dead_zone", barDeadZoneSchema()),
+        field(&BarConfig::clickThrough, "click_through"),
         field(&BarConfig::actions, "actions"),
     };
     return s;
diff --git a/src/shell/bar/bar.cpp b/src/shell/bar/bar.cpp
index 46eadf6..40264b2 100644
--- a/src/shell/bar/bar.cpp
+++ b/src/shell/bar/bar.cpp
@@ -874,6 +874,47 @@ namespace {
     };
   }
 
+  [[nodiscard]] std::vector<InputRect>
+  barWidgetInputRegions(const BarInstance& instance) {
+    std::vector<InputRect> rects;
+    auto collectSection = [&rects](const std::vector<std::unique_ptr<Widget>>& widgets) {
+      for (const auto& widget : widgets) {
+        if (widget == nullptr) continue;
+        auto* root = widget->root();
+        if (root == nullptr || !root->visible()) continue;
+        float absX = 0.0f, absY = 0.0f;
+        Node::absolutePosition(root, absX, absY);
+        const float rw = root->width();
+        const float rh = root->height();
+        if (rw > 0.0f && rh > 0.0f) {
+          const int x = static_cast<int>(std::floor(absX));
+          const int y = static_cast<int>(std::floor(absY));
+          const int width = static_cast<int>(std::ceil(absX + rw)) - x;
+          const int height = static_cast<int>(std::ceil(absY + rh)) - y;
+          rects.push_back(InputRect{x, y, width, height});
+        }
+      }
+    };
+    collectSection(instance.startWidgets);
+    collectSection(instance.centerWidgets);
+    collectSection(instance.endWidgets);
+    return rects;
+  }
+
+  [[nodiscard]] std::vector<InputRect>
+  computeBarInputRegion(const BarInstance& instance, const ShellConfig::ShadowConfig& shadow, int surfW, int surfH, bool fullSurface) {
+    if (instance.barConfig.clickThrough) {
+      if (barConfigUsesSlideSurface(instance.barConfig) && fullSurface) {
+        return barAutoHideSurfaceInputRegion(instance.barConfig, surfW, surfH, true);
+      }
+      return barWidgetInputRegions(instance);
+    }
+    if (barConfigUsesSlideSurface(instance.barConfig)) {
+      return barAutoHideSurfaceInputRegion(instance.barConfig, surfW, surfH, fullSurface);
+    }
+    return {barContentInputRegion(instance.barConfig, shadow, surfW, surfH)};
+  }
+
   std::pair<float, float> computeAutoHideHiddenDelta(
       bool isVertical, bool isBottom, bool isRight, float w, float h, float contentLeft, float contentTop,
       float contentRight, float contentBottom
@@ -3115,11 +3156,11 @@ void Bar::syncBarAutoHideInputRegion(BarInstance& instance) const {
         || instance.attachedPopupCount > 0
         || instance.hideOpacity > 0.5F
         || (instance.barConfig.smartAutoHide && instance.smartAutoHidePinnedVisible);
-    instance.surface->setInputRegion(barAutoHideSurfaceInputRegion(instance.barConfig, surfW, surfH, fullSurface));
+    instance.surface->setInputRegion(computeBarInputRegion(instance, m_config->config().shell.shadow, surfW, surfH, fullSurface));
     return;
   }
   instance.surface->setInputRegion(
-      {barContentInputRegion(instance.barConfig, m_config->config().shell.shadow, surfW, surfH)}
+      {computeBarInputRegion(instance, m_config->config().shell.shadow, surfW, surfH, false)}
   );
 }
 
@@ -3145,7 +3186,7 @@ void Bar::revealAutoHideBar(BarInstance& instance) {
   if (current >= kSettledThreshold) {
     const int surfW = static_cast<int>(instance.surface->width());
     const int surfH = static_cast<int>(instance.surface->height());
-    instance.surface->setInputRegion(barAutoHideSurfaceInputRegion(instance.barConfig, surfW, surfH, true));
+    instance.surface->setInputRegion(computeBarInputRegion(instance, m_config->config().shell.shadow, surfW, surfH, true));
     syncBarSurfaceChrome(instance);
     instance.surface->requestRedraw();
     notifyAttachedPanel();
@@ -3163,7 +3204,7 @@ void Bar::revealAutoHideBar(BarInstance& instance) {
   );
   const int surfW = static_cast<int>(instance.surface->width());
   const int surfH = static_cast<int>(instance.surface->height());
-  instance.surface->setInputRegion(barAutoHideSurfaceInputRegion(instance.barConfig, surfW, surfH, true));
+  instance.surface->setInputRegion(computeBarInputRegion(instance, m_config->config().shell.shadow, surfW, surfH, true));
   syncBarSurfaceChrome(instance);
   instance.surface->requestRedraw();
 }
